# ============================================================================
# Doxygen 設定（英語版）
#
# これまでこのファイルはリポジトリに存在せず、docs/ には誰かの手元の設定で
# 生成された HTML が直接コミットされていた。再生成できない状態だったため、
# 生成済み HTML（Doxygen 1.9.1 の出力）から設定を割り出して書き起こしてある。
#
# 日本語版は Doxyfile.jp が @INCLUDE でこれを読み、言語まわりだけを差し替える。
# 両方まとめて生成するには:
#     doxygen Doxyfile && doxygen Doxyfile.jp
#
# 出力は docs/（英語）と docs/docs_jp/（日本語）で、これは manual/*.md が
# 相互に張っている ../md_manual_*.html というリンクが前提にしている配置である。
# 変えるとページ間のリンクが全滅するので注意すること。
# ============================================================================

PROJECT_NAME           = "SHM"
PROJECT_BRIEF          = "Shared-memory based Handy-communication Manager"
PROJECT_NUMBER         =

OUTPUT_DIRECTORY       = docs
HTML_OUTPUT            = .
CREATE_SUBDIRS         = NO

# 既存の公開 URL を保つために NO にしてある。YES にすると
# classirlab_1_1shm_1_1_ring_buffer.html が classirlab_1_1shm_1_1RingBuffer.html
# に変わり、外部から張られたリンクが全部切れる。
CASE_SENSE_NAMES       = NO
OUTPUT_LANGUAGE        = English

# ----------------------------------------------------------------------------
# 入力
#
# リポジトリ全体を再帰的に読む。manual/*.md はページとして取り込まれ、
# md_manual_<name>.html という名前で出力される。この命名は manual 内の
# 相互リンクが直接書いている名前なので、INPUT の与え方を変えてはならない。
# ----------------------------------------------------------------------------
INPUT                  = .
INPUT_ENCODING         = UTF-8
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.cpp *.md *.py

# docs/ は出力先そのもの。review/ はレビュー記録で、公開ドキュメントではない。
EXCLUDE                = docs \
                         review \
                         build
EXCLUDE_PATTERNS       = */build/* \
                         */build_*/* \
                         */.git/* \
                         *_jp.md

EXAMPLE_PATH           = shm_pub_sub/samples
EXAMPLE_RECURSIVE      = YES

USE_MDFILE_AS_MAINPAGE = manual/index_en.md
MARKDOWN_SUPPORT       = YES

# ----------------------------------------------------------------------------
# 抽出範囲
# ----------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES

# ----------------------------------------------------------------------------
# 出力形式
#
# HAVE_DOT は NO。生成済みの docs/ に graph_legend.html が無く、クラス図が
# Doxygen 内蔵の描画で作られていたことから、元の設定もそうだったと分かる。
# CI に graphviz を入れて YES にしても構わないが、出力が変わる。
# ----------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = NO
SEARCHENGINE           = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES

HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_SECTIONS  = YES

# ----------------------------------------------------------------------------
# 警告
#
# WARN_AS_ERROR は NO のままにしてある。既存のコメントに未文書の引数が多く、
# 一度に潰せないため。CI は警告をログに残すだけでビルドは止めない。
# ----------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# プリプロセッサ
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = SHM_ENABLE_TEST_HOOKS
