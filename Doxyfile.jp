# ============================================================================
# Doxygen 設定（日本語版）
#
# 英語版との差は 4 つだけである。共通部分は Doxyfile を参照すること。
#   1. 出力先を docs/docs_jp/ にする
#   2. OUTPUT_LANGUAGE を Japanese-en にして \~japanese-en のブロックを選ばせる
#   3. 除外パターンを *_en.md にする（英語版は *_jp.md を除外している）
#   4. メインページを manual/index_jp.md にする
#
#     doxygen Doxyfile.jp
# ============================================================================

@INCLUDE               = Doxyfile

HTML_OUTPUT            = docs_jp
OUTPUT_LANGUAGE        = Japanese-en

EXCLUDE_PATTERNS       = */build/* \
                         */build_*/* \
                         */.git/* \
                         *_en.md

USE_MDFILE_AS_MAINPAGE = manual/index_jp.md
